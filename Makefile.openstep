# Build StepTTY on OPENSTEP 4.2 (gcc 2.7.2).  Works with NeXT make or GNU make.
#
#   make -f Makefile.openstep test     # FIRST: run the C unit tests on the real compiler
#   make -f Makefile.openstep          # build StepTTY.app
#   make -f Makefile.openstep install  # into /LocalApps (see below)
#   make -f Makefile.openstep pkg      # StepTTY.pkg for Installer.app (see below)
#   make -f Makefile.openstep dist     # StepTTY.pkg, gzipped as StepTTY-<VERSION>-<letter>.tar.gz
#   make -f Makefile.openstep fat          # StepTTY.app as an i386+m68k+sparc fat binary (see below)
#   make -f Makefile.openstep install-fat  # fat app into /LocalApps
#   make -f Makefile.openstep pkg-fat      # StepTTY.pkg with the fat build
#   make -f Makefile.openstep dist-fat     # fat StepTTY.pkg, gzipped as StepTTY-<VERSION>-NIS.tar.gz
#   make -f Makefile.openstep clean
#
# No GNU-make features are used (no wildcard, no pattern rules) so the stock
# NeXT make can read it.  Object files are written next to their sources.

CC       = cc
OPT      = -O
DEFS     = -DOPENSTEP
ARCHS    =                        # e.g. -arch i386 -arch m68k -arch sparc; see `fat` below
CFLAGS   = $(OPT) -Wall $(DEFS) $(ARCHS) -Iterm -Iapp
LIBS     = -framework AppKit -framework Foundation
APP      = StepTTY.app
VERSION  = 0.1.0

# Workspace takes an application's icon (and its file-type table) from a read-only __ICON segment
# linked into the executable, not from a file in the .app folder (compare /NextApps/Edit.app, whose
# only non-language files are the executable and some TIFFs) -- and, on real hardware, Workspace
# Manager silently refuses to launch a bundle lacking one at all (confirmed: neither `open` nor a
# Workspace double-click did anything for StepTTY.app until this was added -- the exact same failure
# StepSSH hit before it got its own icon). app/StepTTY.iconheader says which icon belongs to the
# app; app/StepTTY.tiff is the icon (regenerate: python3 tools/gen_icon.py).
ICONHDR   = app/StepTTY.iconheader
ICONTIFF  = app/StepTTY.tiff
ICONFLAGS = -sectcreate __ICON __header $(ICONHDR) -segprot __ICON r r -sectcreate __ICON app $(ICONTIFF)

TERM_OBJS = term/nsenc.o term/vt.o
APP_OBJS  = app/AppController.o app/PTYSession.o app/TerminalView.o app/UIHelpers.o app/main.o

.SUFFIXES: .c .m .o

.c.o:
	$(CC) $(CFLAGS) -c $< -o $@

.m.o:
	$(CC) $(CFLAGS) -c $< -o $@

all: $(APP)/StepTTY

$(APP)/StepTTY: $(TERM_OBJS) $(APP_OBJS) $(ICONHDR) $(ICONTIFF)
	-mkdir $(APP)
	@( cd $(APP) ) >/dev/null 2>&1 || { echo "make: $(APP) is missing or is not a directory:"; ls -ld $(APP); echo "remove it and run make again"; exit 1; }
	$(CC) $(ARCHS) -o $(APP)/StepTTY $(TERM_OBJS) $(APP_OBJS) $(ICONFLAGS) $(LIBS) || { echo "make: linking with the __ICON segment failed; retrying without an icon"; $(CC) $(ARCHS) -o $(APP)/StepTTY $(TERM_OBJS) $(APP_OBJS) $(LIBS); }

# Show what was linked in: expect a segment __ICON with sections __header and app.
iconcheck:
	otool -l $(APP)/StepTTY | grep -A 3 __ICON

# ---- unit tests (plain C, no AppKit) ----
# NOTE: OPENSTEP's mkdir has no -p option (it would create a directory named "-p").
build/test_vt: tests/test_vt.c $(TERM_OBJS)
	-mkdir build
	@( cd build ) >/dev/null 2>&1 || { echo "make: build is missing or is not a directory:"; ls -ld build; echo "remove it and run make again"; exit 1; }
	$(CC) $(CFLAGS) -o build/test_vt tests/test_vt.c $(TERM_OBJS)

test: build/test_vt
	build/test_vt

# ---- install ----
# OPENSTEP's own conventions: /LocalApps for a locally-built application (parallel to /NextApps
# for vendor-shipped ones). Needs write access (root, typically); if mkdir/cp fails for that
# reason, su or sudo and try again -- this target does not do that itself. UNVERIFIED: written to
# match OPENSTEP's own directory layout, not yet actually run there.
APPDIR = /LocalApps

install: all
	-mkdir $(APPDIR)
	rm -rf $(APPDIR)/$(APP)
	cp -r $(APP) $(APPDIR)/
	@echo "installed: $(APPDIR)/$(APP)"

install-fat: clean
	$(MAKE) -f Makefile.openstep all ARCHS="$(FATARCHS)"
	-mkdir $(APPDIR)
	rm -rf $(APPDIR)/$(APP)
	cp -r $(APP) $(APPDIR)/
	@echo "installed fat (i386+m68k+sparc) binary: $(APPDIR)/$(APP)"

# ---- Installer package (.pkg) ----
# Built with the real packaging tool, not a hand-rolled imitation of its output -- see StepSSH's
# own Makefile.openstep for the full story of how that mechanism was worked out (real HOWTO +
# real reference package + real hardware, several rounds). Applying those lessons directly here
# rather than re-deriving them: NEXTSTEP/OPENSTEP's Installer.app ships a csh script,
# /NextAdmin/Installer.app/package, that takes a "fake root" tree (the payload, laid out under
# DefaultLocation as if it were /) and a plain-text ".info" file (single "Keyword value" lines,
# NOT a "{ Key = value; }" property list) and does everything else itself: the compressed archive,
# the .bom, the .sizes file, and the finished .pkg. DefaultLocation /LocalApps with StepTTY.app as
# the only payload -- matching a real shipped single-app package's own layout exactly (Lighthouse
# Design's OpenWrite.pkg), so (unlike StepSSH, which needed a second /usr/local-rooted package for
# its command-line tools) there's no reason to split this into more than one .pkg. LongFileNames
# NO (StepTTY.app's own path is nowhere near the 100-character ustar limit, and YES was the actual
# root cause of a hard-to-diagnose StepSSH install failure -- it silently selects a buggy bundled
# tar variant for small archives). chgrp nogroup and chmod 444 on .sizes match a known-good
# reference package's own structure exactly, though neither turned out to be load-bearing for
# StepSSH's own bug -- kept here anyway since they're free and correct either way.
#
# UNVERIFIED: not yet tested on real OPENSTEP hardware. If it fails, compare against a real
# package's actual .bom/.info/.sizes contents (lsbom(8)) before guessing -- that, not
# documentation, is what actually cracked StepSSH's version of this.
PKG     = StepTTY.pkg
PKGROOT = pkgroot
PKGINFO = StepTTY.info

pkg-assemble:
	rm -rf $(PKG) $(PKGROOT) $(PKGINFO)
	mkdir $(PKGROOT)
	chgrp nogroup $(PKGROOT)
	cp -r $(APP) $(PKGROOT)/
	echo "Title StepTTY" > $(PKGINFO)
	echo "Version $(VERSION)" >> $(PKGINFO)
	echo "Description A local terminal emulator for OPENSTEP." >> $(PKGINFO)
	echo "DefaultLocation /LocalApps" >> $(PKGINFO)
	echo "DiskName StepTTY" >> $(PKGINFO)
	echo "Relocatable YES" >> $(PKGINFO)
	echo "Application YES" >> $(PKGINFO)
	echo "UseUserMask YES" >> $(PKGINFO)
	echo "LongFileNames NO" >> $(PKGINFO)
	/NextAdmin/Installer.app/package $(PKGROOT)/ $(PKGINFO)
	-chmod 444 $(PKG)/StepTTY.sizes
	rm -rf $(PKGROOT) $(PKGINFO)
	@echo "built $(PKG) via the real Installer.app/package tool"

pkg: all pkg-assemble

pkg-fat: clean
	$(MAKE) -f Makefile.openstep all ARCHS="$(FATARCHS)"
	$(MAKE) -f Makefile.openstep pkg-assemble

# ---- distributable archive of the .pkg ----
# Gzipped into StepTTY-<VERSION>-<letter(s)>.tar.gz for handing out. The letter convention
# (N=m68k, I=i386, S=sparc) matches StepSSH's own (in turn matching "Making Packages I"'s example
# naming, diff-2.7-N.tar.gz, "N - NeXT hardware") -- NIS for `dist-fat` (always, since that's
# exactly what `fat`/`pkg-fat` build), or whichever single letter matches the machine `dist` (thin)
# actually ran on, found with arch(1). UNVERIFIED: arch(1)'s exact output and its presence at that
# path are assumed, not confirmed here (StepSSH's own equivalent is also still unconfirmed).
dist: pkg
	case "`arch`" in \
	    m68k) suf=N ;; \
	    i386) suf=I ;; \
	    sparc) suf=S ;; \
	    *) suf="`arch`" ;; \
	esac; \
	tar -cvf - $(PKG) | gzip -9c > StepTTY-$(VERSION)-$$suf.tar.gz; \
	echo "built StepTTY-$(VERSION)-$$suf.tar.gz"

dist-fat: pkg-fat
	tar -cvf - $(PKG) | gzip -9c > StepTTY-$(VERSION)-NIS.tar.gz
	@echo "built StepTTY-$(VERSION)-NIS.tar.gz"

# ---- optional multi-architecture ("fat") build ----
# NeXT's cc accepts several -arch flags in one invocation: each source is compiled once per
# architecture and the per-arch object code is combined into one fat Mach-O file automatically,
# and linking with the same set of -arch flags produces a fat executable. This only works if the
# target architecture's compiler backend is actually installed as part of your Developer Tools;
# the m68k/sparc components were separate from a plain Intel install on some OPENSTEP CD sets.
#
#   make -f Makefile.openstep fat-check    # fast: does cc even accept these -arch flags here?
#   make -f Makefile.openstep fat          # full: StepTTY.app as an i386+m68k+sparc fat binary
#   make -f Makefile.openstep fat FATARCHS="-arch i386 -arch m68k"   # a different arch set
#
# UNVERIFIED: StepSSH confirmed this exact mechanism works, including m68k actually executing (not
# just linking) on a real Previous-emulated 68040 -- but that was StepSSH's own binary; StepTTY's
# hasn't been tried on anything but i386 (the dev host, via the ptmx test path, not even that for
# real) yet. sparc remains unconfirmed for either project.
FATARCHS = -arch i386 -arch m68k -arch sparc

fat-check:
	@echo "int main(void) { return 0; }" > /tmp/tty_fatcheck.c
	$(CC) $(FATARCHS) -c /tmp/tty_fatcheck.c -o /tmp/tty_fatcheck.o
	@echo "compiled for all requested architectures; slices actually present:"
	lipo -info /tmp/tty_fatcheck.o
	@rm -f /tmp/tty_fatcheck.c /tmp/tty_fatcheck.o

fat: clean
	$(MAKE) -f Makefile.openstep all ARCHS="$(FATARCHS)"
	@echo "== fat link done; architectures actually present in $(APP)/StepTTY: =="
	lipo -info $(APP)/StepTTY

clean:
	rm -f term/*.o app/*.o
	rm -rf build $(APP) $(PKG) $(PKGROOT) $(PKGINFO)
	rm -f StepTTY-*.tar.gz
